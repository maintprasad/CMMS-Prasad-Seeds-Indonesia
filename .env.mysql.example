# Salin menjadi ".env.mysql" (tidak ikut git), lalu: php scripts/db-check.php --env=.env.mysql
DB_DRIVER=mysql
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=cmms
MYSQL_USER=cmms
MYSQL_PASSWORD=
# MYSQL_SOCKET=/var/run/mysqld/mysqld.sock   (opsional, menggantikan host/port)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_NAME=Administrator
APP_TIMEZONE=Asia/Jakarta
