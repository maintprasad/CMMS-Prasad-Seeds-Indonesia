# Salin menjadi ".env" (tidak ikut git). Di Vercel isi lewat Environment Variables.
DB_DRIVER=sqlite
SQLITE_PATH=database/cmms.db
# Turso (production / Vercel)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Admin pertama (dibuat otomatis bila tabel users kosong)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_NAME=Administrator
APP_TIMEZONE=Asia/Jakarta
