{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["iad1"],
  "functions": {
    "api/index.php": { "runtime": "vercel-php@0.9.0", "includeFiles": "api/**", "maxDuration": 30 }
  },
  "headers": [{ "source": "/(sw.js|manifest.webmanifest)", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }, { "source": "/api/(.*)", "headers": [{ "key": "Cache-Control", "value": "no-store" }] }]
}
